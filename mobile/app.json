{
  "expo": {
    "name": "Prointeractive",
    "slug": "prointeractive",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "prointeractive",
    "ios": {
      "bundleIdentifier": "com.proint",
      "supportsTablet": false,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.proint",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "apiUrl": "https://prointeractive.onrender.com",
      "googleClientId": "486712223464-qt91nunrjuuq9onc897it8dcujkc61rn.apps.googleusercontent.com",
      "googleClientIdIOS": "486712223464-1f0d5dach6b7eof215fqd66coam4cmfj.apps.googleusercontent.com",
      "eas": {
        "projectId": "139f5e42-7f27-45c4-9dab-262a43cb72fa"
      }
    },
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Prointeractive to access your photos so you can add product images to your store."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.486712223464-1f0d5dach6b7eof215fqd66coam4cmfj"
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
