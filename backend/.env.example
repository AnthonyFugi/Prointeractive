# ============================================================
# Prointeractive backend — environment variables
# ============================================================
# Required to boot at all: MONGO_URI, JWT_SECRET (see server.js).
# Everything else is optional — its feature just won't work without it.

# --- Required ---
PORT=5001
MONGO_URI=mongodb://localhost:27017/prointeractive
JWT_SECRET=change_this_to_a_long_random_string

# --- Core / infra ---
NODE_ENV=development
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Set automatically by Render in production — used for link previews (OG tags)
RENDER_EXTERNAL_URL=

# --- Image uploads (AWS S3) ---
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read implicitly by the AWS SDK's
# default credential chain — not referenced by name in our own code, but required
# for uploads to work at all.
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret
S3_BUCKET=prointeractive-uploads

# --- Email ---
# Preferred: Brevo HTTPS API key (xkeysib-...) — works on hosts that block SMTP
# ports (e.g. Render free tier). Leave SMTP_HOST empty to disable the fallback.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Prointeractive <no-reply@yourdomain.com>
# Where verification requests, corporate leads, etc. get emailed
ADMIN_EMAIL=hello@fugipay.com

# --- Payments (Flutterwave) ---
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=set_this_same_value_in_flutterwave_dashboard
# Flat platform commission, % of each order (no ceiling — see utils/flutterwave.js)
PLATFORM_FEE_PERCENT=5

# --- Social sign-in ---
# Google: client ID is public (also goes in the frontend); secret stays here only.
# Web uses GOOGLE_CLIENT_ID directly. Mobile (LoginScreen/RegisterScreen,
# via expo-auth-session) can either reuse this SAME client ID — just add
# prointeractive:// to its Authorized redirect URIs in Google Cloud Console
# and set mobile/app.json's extra.googleClientId to match — or use its own
# dedicated "Web application" type client via GOOGLE_CLIENT_ID_ANDROID/IOS
# below. Either way, googleAuth() in authController.js already accepts all
# three as valid audiences, so no backend code changes are needed regardless
# of which path is chosen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
# Apple: Services ID (web) and bundle ID (iOS) — see SOCIAL_AUTH_SETUP.md.
# APPLE_BUNDLE_ID is what mobile's native Sign in with Apple
# (LoginScreen/RegisterScreen, via expo-apple-authentication) verifies against.
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.proint

# --- Monitoring & ops ---
SENTRY_DSN=
# Set to "true" to enable the nightly backup-to-S3 job
BACKUP_TO_S3=false
