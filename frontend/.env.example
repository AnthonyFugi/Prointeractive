# ============================================================
# Prointeractive frontend — environment variables
# ============================================================
# Vite only exposes vars prefixed VITE_ to the browser bundle — anything
# without that prefix is invisible to the frontend by design. Never put a
# secret (like a Google/Apple client SECRET) in a VITE_ variable — it ships
# to every visitor's browser.

# Backend API base. Point at localhost for dev, the Render URL for production.
VITE_API_URL=http://localhost:5001

# Google sign-in — public client ID only (the matching secret lives on the
# backend). Leave unset and the Google button simply doesn't render.
VITE_GOOGLE_CLIENT_ID=

# Apple sign-in — Services ID + the registered redirect URL.
# Apple does not accept localhost, so this only ever renders on the deployed
# site — leave both unset for local development.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://proint.web.app/login

# Display-only USD conversion rate for the currency preference (ZMW/USD).
# All real payments still settle in Kwacha regardless of this value.
VITE_USD_ZMW_RATE=18
