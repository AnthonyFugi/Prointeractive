
# Production
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Email notifications (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Prointeractive <no-reply@yourdomain.com>
APP_URL=http://localhost:5173

# Flutterwave payments
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=set_this_same_value_in_flutterwave_dashboard

# Marketplace commission (% of each order kept by the platform on split payments)
PLATFORM_FEE_PERCENT=5
